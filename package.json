{
  "name": "trello-server",
  "version": "1.0.0",
  "description": "Backend server for Trello-style project management app",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrator.js single",
    "migrate:master": "node src/db/migrator.js master",
    "migrate:tenants": "node src/db/migrator.js tenants",
    "tenants:list": "node src/scripts/tenantsList.js",
    "tenants:reconcile": "node src/scripts/tenantsReconcile.js",
    "db:status": "node src/db/migrator.js status",
    "seed": "node src/db/seed.js",
    "test": "node test_tenant_isolation_and_crud.js",
    "db:clean": "node src/scripts/cleanLocalDb.js",
    "rbac:audit": "node src/scripts/rbacAudit.js",
    "rbac:sync-check": "node src/scripts/rbacSyncCheck.js",
    "notify:audit": "node src/scripts/notifyAudit.js",
    "audit:coverage": "node src/scripts/auditCoverage.js",
    "audit:backfill": "node src/scripts/backfillAuditEvents.js",
    "audit:archive": "node src/scripts/auditArchive.js",
    "audit:triggers": "node src/scripts/auditTriggers.js",
    "audit:anchor": "node src/scripts/auditAnchor.js",
    "notifications:cleanup": "node src/scripts/notificationsCleanup.js",
    "test:notifications": "node src/scripts/permtest/notificationNoiseAndSound.test.js",
    "work_events:backfill": "node src/scripts/backfillWorkEvents.js",
    "contract:check": "node src/scripts/checkApiContract.js",
    "coverage:matrix": "node src/scripts/generateCoverageMatrix.js",
    "admin:reset-password": "node src/scripts/adminResetPassword.js",
    "admin:reset-2fa": "node src/scripts/adminReset2fa.js",
    "db:clean-local": "node src/scripts/cleanLocalDb.js && node src/db/seed.js",
    "db:clean-test": "node src/scripts/cleanTestDatabases.js",
    "db:reset-live": "node src/scripts/resetLiveDb.js",
    "check:prod-env": "node src/scripts/checkProdEnv.js",
    "secrets:scan": "node src/scripts/scanSecrets.js",
    "push:live-test": "node src/scripts/pushLiveTest.js",
    "backup": "node src/scripts/backup.js",
    "backup:restore": "node src/scripts/restoreBackup.js",
    "permtest:provision": "node src/scripts/permtestProvision.js",
    "permtest:drop": "node src/scripts/permtestDrop.js",
    "permcheck": "node src/scripts/permcheck.js",
    "test:perm": "node src/scripts/permtest/index.js",
    "test:perm:fast": "node src/scripts/permtest/index.js --fast",
    "test:perm:static": "node src/scripts/permtest/static.js",
    "test:perm:reg": "node src/scripts/permtest/runRegressions.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.24.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.6",
    "socket.io": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pg": "^8.12.0",
    "socket.io-client": "^4.8.4"
  }
}
