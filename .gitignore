# Dependency directories
node_modules/
jspm_packages/

# Environment and secret files
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# File uploads and user media
uploads/
public/uploads/
server/public/uploads/

# Backups and database dumps
backups/
*.dump
*.sql.gz
*.zip
*.tar.gz
*.tgz

# Never ignore migration scripts or schema definitions
!src/db/migrations/
!src/db/migrations/**/*.sql
!src/db/schema.sql
!src/db/seed.sql

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test output, runners, and coverage
coverage/
.nyc_output/
src/test_*.js
test_*.js
tests/
test/
src/test_utils/
.coverage_records.json
**/.coverage_records.json

# Temporary, scratch, and cache files
scratch/
tmp/
temp/
.temp/
.cache/

# Process and runtime files
pids/
*.pid
*.seed
*.pid.lock

# IDE and Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
*.bak
*~

# Operating System files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
