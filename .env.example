PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL / MariaDB Settings (XAMPP defaults)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# Database Names & Prefixes
MYSQL_MASTER_DATABASE=pm_master
MYSQL_TENANT_PREFIX=pm_t_
MYSQL_DATABASE=pm_dev_single

# Connection Pool Settings
MYSQL_POOL_LIMIT=10
TENANT_POOL_LIMIT=5
MAX_OPEN_TENANT_POOLS=50

# Development Mode (Set to 1 to run against single-tenant pm_dev_single; default 0 is multi-tenant)
DEV_SINGLE_TENANT=0

# Registration & Verification Settings
# VERIFICATION_MODE: "off" (default) provisions tenants immediately without email/OTP. "on" requires OTP verification.
VERIFICATION_MODE=off
# REGISTRATION_ENABLED: set to false/0 to close public company registration
REGISTRATION_ENABLED=true

# Secrets (required; minimum 32 chars in production)
JWT_SECRET=change-this-to-a-secure-random-secret-key-minimum-32-chars

# Pluggable Providers (console | smtp, console | twilio)
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# Optional SMTP Settings (when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Project Management <noreply@pm.local>"

# Optional SMS Provider Settings (when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
